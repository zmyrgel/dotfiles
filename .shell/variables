# Variables -*- mode: sh; coding: utf-8-unix; -*-

HISTSIZE=2000
PAGER=less
LESS="-R -M -I -X -F -i"
CVS_RSH=ssh

export HISTSIZE HISTFILE PAGER LESS CVS_RSH

if command -v emacsclient >/dev/null 2>&1
then
	VISUAL='emacsclient'
elif command -v mg >/dev/null 2>&1
then
	VISUAL='mg'
fi

ALTERNATE_EDITOR="${VISUAL:-vi}"
EDITOR="${VISUAL:-vi}"
VISUAL="${VISUAL:-vi}"
FCEDIT="${VISUAL:-vi}"
export ALTERNATE_EDITOR EDITOR VISUAL FCEDIT

### PATH ###
PATH=$HOME/bin:/bin:/sbin:/usr/bin:/usr/sbin
if [ -d /usr/X11R6/bin ]
then
	PATH=$PATH:/usr/X11R6/bin
fi
PATH=$PATH:/usr/local/bin:/usr/local/sbin

if [ -x /usr/games ]
then
	PATH=$PATH:/usr/games
fi

if [ -x $HOME/.local/bin ]
then
	PATH=$PATH:$HOME/.local/bin
fi

# Go programming
GOPATH=$HOME/workspace
export GOPATH
if [ -x $GOPATH/bin ]
then
	PATH=$GOPATH/bin:$PATH
fi
if [ -x /usr/local/go/bin ]
then
	PATH=/usr/local/go/bin:$PATH
fi
export PATH=$HOME/go/bin:$PATH

# NPM setup
if [ -x $HOME/.npm-global ]
then
	NPM_CONFIG_PREFIX=$HOME/.npm-global
	PATH=$HOME/.npm-global/bin:$PATH
fi
export NPM_CONFIG_PREFIX

# Perl local-lib setup
if test -d $HOME/perl5/lib/perl5
then
	eval "$(perl -I$HOME/perl5/lib/perl5 -Mlocal::lib)"
fi

if test -d /opt/rocm/bin
then
	PATH=$PATH:/opt/rocm/bin
	LD_LIBRARY_PATH=/opt/rocm/lib
fi

export LD_LIBRARY_PATH
export PATH
